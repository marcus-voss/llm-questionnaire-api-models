# Copy this file to `.env` and fill in the API keys for the providers you want to query.
# `run_llm_eval.py` loads these via python-dotenv / aisuite.
# You only need keys for the providers listed in MODEL_LIST in run_llm_eval.py.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# --- Optional: Google Gemini (disabled by default in MODEL_LIST) ---
# Gemini via aisuite uses a Google Cloud service account, not a simple key:
# GOOGLE_PROJECT_ID=
# GOOGLE_REGION=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
