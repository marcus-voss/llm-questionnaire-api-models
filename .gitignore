# --- Secrets (never commit) ---
.env
# Service-account keys (e.g. gen-lang-client-*.json)
*.json

# --- Generated results / run artifacts ---
# Each run writes its own OUTPUT_DIR; only the tracked `example_output/` is kept.
outputs/
outputs_*/
final_results/
*.log
run.pid

# --- Notebook / plotting artifacts ---
.ipynb_checkpoints/
notebooks/outputs_*/
# Generated by 1_compare_rollen.ipynb
notebooks/rollen_*
notebooks/*.xlsx
*.png
*.pdf

# --- Python / OS ---
__pycache__/
*.pyc
.cache
.venv
.DS_Store
.vscode

# --- Keep: data inputs and the reference run (override broad rules above) ---
!data/**
!example_output/**
